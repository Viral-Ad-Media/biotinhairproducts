# Neon Postgres connection string (Neon console -> Connection details, pooled)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generate with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated emails allowed to create an admin account and edit posts
ADMIN_EMAILS="you@example.com"

# Public site URL, used for canonical links and the sitemap
NEXT_PUBLIC_SITE_URL="https://biotinhairproducts.com"
